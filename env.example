# Copy this file to .env and fill in your own values. Never commit .env.

# --- Required: Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource-or-gateway.example.com/
AZURE_OPENAI_API_KEY=your-azure-key-here
OPENAI_API_VERSION=your-api-version
AZURE_CHAT_DEPLOYMENT=gpt-5-mini

# --- Optional (leave commented out to run without them) ---
# AZURE_EMBEDDING_DEPLOYMENT=your-embedding-deployment   # otherwise local hashing embeddings are used
# TAVILY_API_KEY=your-tavily-key-here                    # otherwise web search is off
# LANGSMITH_API_KEY=your-langsmith-key-here              # otherwise local JSONL tracing only
